{% extends 'layout.html.twig' %}

{% block title %}Page non trouvée - 404 - NVH Studio{% endblock %}

{% block body %}
    <section class="error-page-section">
        <div class="container error-page-container">
            <div class="error-content-box">
                <h1 class="error-huge-code">404</h1>
                <h2 class="error-main-title">Oups ! Page introuvable</h2>
                <p class="error-lead-text">
                    La page que vous recherchez a peut-être été déplacée, supprimée ou n'existe plus. 
                    Vérifiez l'adresse saisie ou retournez à l'accueil.
                </p>
                <a href="{{ app.base_path }}/" class="btn btn-primary error-return-btn">
                    Retourner à l'accueil
                </a>
            </div>
        </div>
    </section>
{% endblock %}
