{# --- FRAGMENT DE PAGE : CONTACT SECTION REFONDUE PREMIUM --- #}
<section id="contact" class="contact-section-premium">
    <div class="container">
        
        <div class="contact-grid-split">
            
            {# --- COLONNE GAUCHE : RÉASSURANCE ET OFFRE COMMERCIALE --- #}
            <div class="contact-info-column">
                <span class="offer-badge badge-accent">Votre Projet</span>
                <h2 class="section-title-left">Prêt à propulser votre présence en ligne ?</h2>
                
                <p class="contact-lead-text">
                    Tout comme dans le milieu hospitalier, chaque détail compte. Confiez la création de votre site internet à un artisan du web rigoureux, à l'écoute des contraintes des soignants comme des indépendants
                </p>

                {# 🌟 BLOC ENCART DE GRATUITÉ VALORISÉ #}
                <div class="commercial-trust-card">
                    <div class="trust-card-icon">
                        <div class="mini-star"></div>
                    </div>
                    <div class="trust-card-content">
                        <h3>Premier rendez-vous & Devis 100% gratuits</h3>
                        <p>Étudions ensemble vos besoins professionnels et vos contraintes de temps, sans aucun engagement de votre part.</p>
                    </div>
                </div>

                <div class="hero-trust-line">
                    <span class="mini-star"></span> Performance absolue & Excellence technique <span class="mini-star"></span>
                </div>
            </div>

            {# --- COLONNE DROITE : FORMULAIRE PREMIUM DARK --- #}
            <div class="contact-form-column">
                <div class="contact-wrapper-premium">

                    <form action="{{ app.base_path }}/contact" method="POST" id="contact-form" novalidate>
                        
                        {# --- AFFICHAGE DYNAMIQUE DES ERREURS DE SAISIE DU SERVICE --- #}
                        {% if has_flash('error') %}
                            <div style="background-color: #fef2f2; border: 1px solid #fee2e2; color: #991b1b; padding: 0.75rem 1rem; border-radius: 6px; margin-bottom: 1.5rem; font-size: 0.9rem; font-weight: 500;">
                                ⚠️ {{ get_flash('error') }}
                            </div>
                        {% endif %}

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token() }}">
                        
                        <div class="form-group">
                            <label for="name" class="form-label">Nom complet</label>
                            <input type="text" id="name" name="name" class="form-control-premium" placeholder="Jean Dupont" required>
                        </div>

                        <div class="form-group-split">
                            <div>
                                <label for="email" class="form-label">Adresse email</label>
                                <input type="email" id="email" name="email" class="form-control-premium" placeholder="jean.dupont@exemple.com" required>
                            </div>
                            <div>
                                <label for="phone" class="form-label">Numéro de téléphone</label>
                                <input type="tel" id="phone" name="phone" class="form-control-premium" placeholder="06 12 34 56 78" pattern="[0-9]{10}" title="Le numéro doit comporter 10 chiffres.">
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="message" class="form-label">Votre message</label>
                            <textarea id="message" name="message" class="form-control-premium" placeholder="Décrivez brièvement vos besoins ou votre projet (cabinet, entreprise, artisanat)..." required></textarea>
                        </div>

                        <button type="submit" class="btn-hero-xl">
                            <span style="display: inline-flex; align-items: center; gap: 8px;">
                                <svg xmlns="http://w3.org" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <rect width="20" height="16" x="2" y="4" rx="2"/>
                                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                                </svg>
                                Envoyer ma demande
                            </span>
                        </button>

                    </form>
                    
                </div>
            </div>

        </div>
    </div>
</section>
